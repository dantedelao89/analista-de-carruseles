# Token de Apify (https://console.apify.com/account/integrations)
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API key de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de Gemini via OpenRouter (por defecto Flash: barato y rapido)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Puerto del servidor local
PORT=3000
